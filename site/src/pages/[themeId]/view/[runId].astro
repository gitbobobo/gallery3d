---
import Base from '../../../layouts/Base.astro';
import TierMark from '../../../components/TierMark.astro';
import { baseUrl, loadThemes, workEntry, type Run, type Theme } from '../../../data';
import { fmtBytes, fmtCost, fmtCount, fmtDuration, fmtTime, sha8 } from '../../../format';
import { renderMd } from '../../../md';

export const getStaticPaths = () =>
  loadThemes().flatMap((theme) =>
    theme.runs.map((run, i) => ({
      params: { themeId: theme.id, runId: run.id },
      props: {
        theme,
        run,
        prev: theme.runs[i - 1] ?? null,
        next: theme.runs[i + 1] ?? null,
      },
    })),
  );

interface Props { theme: Theme; run: Run; prev: Run | null; next: Run | null }
const { theme, run, prev, next } = Astro.props;

const src = workEntry(theme.id, run.id);
const notesHtml = run.notesMd ? renderMd(run.notesMd) : '';
const tier = theme.ratings.tiers.find((t) => t.id === run.tierId) ?? null;
const domains = run.stats.externalDomains ?? [];
const navLabel = (r: Run) => `${r.modelName} · ${r.harnessName}`;

// warn 列：不用颜色，只用 600 字重 + "▲ " 前缀
type Row = { k: string; v: string; sub?: string; warn?: boolean };
const metaRows: Row[] = [
  { k: '模型', v: run.modelName, sub: run.model },
  { k: 'Agent', v: run.harnessName, sub: run.harnessVersion },
  { k: '强度', v: run.effort },
  { k: '用时', v: fmtDuration(run.stats.durationMs) },
  { k: 'Token', v: `${fmtCount(run.stats.tokensIn)} in · ${fmtCount(run.stats.tokensOut)} out` },
  { k: '成本', v: fmtCost(run.stats.costUsd) },
  { k: '产物大小', v: fmtBytes(run.stats.distBytes) },
  {
    k: '控制台报错',
    v: run.stats.consoleErrors === undefined ? '—' : String(run.stats.consoleErrors),
    warn: (run.stats.consoleErrors ?? 0) > 0,
  },
  {
    k: '外部域名',
    v: domains.length ? domains.join('\n') : '无',
    warn: domains.length > 0,
  },
  { k: '完成时间', v: fmtTime(run.finishedAt ?? run.importedAt) },
  { k: '状态', v: run.hasDist ? '能打开' : '没有交卷', warn: !run.hasDist },
  ...(run.reasons.length ? [{ k: '原因', v: run.reasons.join('；'), warn: true }] : []),
  ...(run.promptSha256 ? [{ k: '提示词编号', v: sha8(run.promptSha256) }] : []),
  { k: '答卷 id', v: run.id },
];
---

<Base title={`${run.modelName} · ${run.harnessName} · ${theme.meta.title}`}>
  <div class="viewer">
    <header class="vbar">
      <a class="vback" href={baseUrl(`${theme.id}/`)}>← {theme.meta.title}</a>
      <span class="vsep" aria-hidden="true">│</span>
      <div class="vtitle">
        {tier && <TierMark tier={tier} size="sm" />}
        <span class="vplace">
          {run.place !== undefined ? `第 ${run.place} 名 · 共 ${theme.runs.length} 份` : '未评级'}
        </span>
        <h1>{run.modelName}</h1>
        <span class="vsub">{run.harnessName} · <span class="mono">{run.effort}</span></span>
      </div>
      <div class="vtools">
        {prev ? (
          <a class="btn" href={baseUrl(`${theme.id}/view/${prev.id}/`)} aria-label={`上一份：${navLabel(prev)}`} title={`上一份：${navLabel(prev)}`}>‹</a>
        ) : (
          <span class="btn" aria-disabled="true">‹</span>
        )}
        {next ? (
          <a class="btn" href={baseUrl(`${theme.id}/view/${next.id}/`)} aria-label={`下一份：${navLabel(next)}`} title={`下一份：${navLabel(next)}`}>›</a>
        ) : (
          <span class="btn" aria-disabled="true">›</span>
        )}
        {run.hasDist && (
          <div class="seg" role="group" aria-label="预览尺寸" id="size-seg">
            <button type="button" aria-pressed="true" data-size="desktop">桌面</button>
            <button type="button" aria-pressed="false" data-size="mobile">手机</button>
          </div>
        )}
        <button class="btn" type="button" id="info-btn" aria-expanded="false">信息</button>
        <a class="btn" href={baseUrl(`${theme.id}/compare/?a=${run.id}`)}>对比</a>
        {run.hasDist && (
          <a class="btn" href={src} target="_blank" rel="noreferrer" aria-label="新窗口打开" title="新窗口打开">↗</a>
        )}
      </div>
    </header>

    <div class="stage" id="stage" data-size="desktop">
      {run.hasDist ? (
        <iframe
          src={src}
          title={`${theme.meta.title} — ${run.modelName} · ${run.harnessName} 的答卷`}
          sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock"
          allow="fullscreen"
        ></iframe>
      ) : (
        <div class="empty-sheet">
          <h2>没有交卷</h2>
          {run.reasons.length > 0 && <p>{run.reasons.join('；')}</p>}
          {(run.stats.durationMs !== undefined || run.stats.tokensIn !== undefined) && (
            <p>
              用了 {fmtDuration(run.stats.durationMs)}，读入 {fmtCount(run.stats.tokensIn)} token，写出 {fmtCount(run.stats.tokensOut)} token。
            </p>
          )}
        </div>
      )}
      {run.status !== 'ok' && run.hasDist && (
        <div class="stage-flag" title={run.reasons.join('；')}>
          未完成{run.reasons.length ? ` · ${run.reasons.join('；')}` : ''}
        </div>
      )}
    </div>

    <div class="scrim" id="scrim"></div>
    <aside class="drawer" id="drawer" aria-label="答卷信息">
      <div class="drawer-head">
        <span class="drawer-title">答卷信息</span>
        <button class="btn" type="button" id="drawer-close" aria-label="关闭">✕</button>
      </div>
      <dl class="meta-list">
        {metaRows.map((row) => (
          <div>
            <dt>{row.k}</dt>
            <dd class:list={[{ warn: row.warn }]}>
              {row.warn ? `▲ ${row.v}` : row.v}
              {row.sub && <span class="dd-sub">{row.sub}</span>}
            </dd>
          </div>
        ))}
      </dl>
      {notesHtml && (
        <>
          <h2 class="drawer-sub">NOTES.md（agent 自己写的说明）</h2>
          <div class="notes" set:html={notesHtml} />
        </>
      )}
    </aside>
  </div>

  <script>
    const stage = document.getElementById('stage')!;
    document.getElementById('size-seg')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-size]');
      if (!btn) return;
      document.querySelectorAll('#size-seg button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      stage.dataset.size = btn.dataset.size === 'mobile' ? 'mobile' : 'desktop';
    });

    const drawer = document.getElementById('drawer')!;
    const scrim = document.getElementById('scrim')!;
    const infoBtn = document.getElementById('info-btn')!;
    const setOpen = (open: boolean) => {
      drawer.classList.toggle('open', open);
      scrim.classList.toggle('open', open);
      infoBtn.setAttribute('aria-expanded', String(open));
    };
    infoBtn.addEventListener('click', () => setOpen(!drawer.classList.contains('open')));
    document.getElementById('drawer-close')!.addEventListener('click', () => setOpen(false));
    scrim.addEventListener('click', () => setOpen(false));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  </script>
</Base>
