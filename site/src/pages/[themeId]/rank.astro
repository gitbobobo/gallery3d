---
// 调整评级板：dev-only（getStaticPaths 在生产构建返回 []）。
// 拖动卡片改等级/名次，松手自动 POST /__api/rate 写 ratings.json。
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import { baseUrl, loadThemes, workEntry, workUrl, type Theme } from '../../data';

export const getStaticPaths = () => {
  if (!import.meta.env.DEV) return [];
  return loadThemes().map((theme) => ({ params: { themeId: theme.id }, props: { theme } }));
};

interface Props { theme: Theme }
const { theme } = Astro.props;
const { tiers, rows } = theme.ratings;

// rows 已由 normalizeRatings 清洗（每 run 至多出现在一个等级行），
// 未出现在任何等级行的即未评级
const pool = theme.runs.filter((r) => r.tierId === undefined);
const cardLabel = (r: Theme['runs'][number]) => `${r.modelName} · ${r.harnessName}`;
const cover = (r: Theme['runs'][number]) => r.coverDesktop ?? r.coverMobile;
---

<Base title={`调整评级 · ${theme.meta.title}`}>
  <div class="rank-shell">
    <TopBar
      crumbs={[
        { label: theme.meta.title, href: baseUrl(`${theme.id}/`) },
        { label: '调整评级' },
      ]}
    >
      <span class="save-state" id="save-state"></span>
    </TopBar>
    <p class="rank-hint">拖动卡片调整等级和名次，松手自动保存到 ratings.json。双击卡片打开答卷，点眼睛图标预览。</p>

    <div
      class="tier-board"
      id="board"
      data-theme={theme.id}
      data-api={baseUrl('__api/rate')}
    >
      {
        [...tiers, { id: '', label: '未评级', color: '' }].map((t) => (
          <div class:list={['tier-row', { 'tier-row--pool': !t.id }]}>
            <div class="tier-label" style={t.color ? `background:${t.color}` : undefined}>
              <span>{t.label}</span>
            </div>
            <div class="tier-body" data-tier={t.id}>
              {(t.id ? (rows[t.id] ?? []) : pool.map((r) => r.id)).map((id) => {
                const r = theme.runs.find((x) => x.id === id);
                if (!r) return null;
                const img = cover(r);
                return (
                  <div
                    class:list={['tcard', { 'tcard--empty': !img }]}
                    data-run={r.id}
                    data-href={baseUrl(`${theme.id}/view/${r.id}/`)}
                    style={img ? `background-image:url(${workUrl(theme.id, r.id)}${img})` : undefined}
                  >
                    {!img && <span class="tcard-blank">{r.hasDist ? '没有封面' : '没有交卷'}</span>}
                    {r.hasDist && (
                      <a class="tcard-zoom" href={`#z-${r.id}`} aria-label="预览效果" title="预览效果">
                        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                          <path d="M1.5 8s2.5-4.5 6.5-4.5S14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z" />
                          <circle cx="8" cy="8" r="2" />
                        </svg>
                      </a>
                    )}
                    <span class="tcard-name">{cardLabel(r)}</span>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  {theme.runs.filter((r) => r.hasDist).map((r) => (
    <div class="lightbox" id={`z-${r.id}`}>
      <a class="lb-backdrop" href="#_" aria-label="关闭" />
      <iframe src={workEntry(theme.id, r.id)} loading="lazy" title={cardLabel(r)} />
      <a class="lb-close" href="#_" aria-label="关闭">×</a>
      <span class="lb-cap mono">{cardLabel(r)}</span>
    </div>
  ))}

  <script type="application/json" id="tiers-data" set:html={JSON.stringify(theme.ratings.tiers).replace(/</g, '\\u003c')} />

  <script>
    import Sortable from 'sortablejs';

    const board = document.getElementById('board')!;
    const saveState = document.getElementById('save-state')!;
    // tiers 原样回传（不再从 DOM 的 style.background 反推颜色）
    const TIERS = JSON.parse(document.getElementById('tiers-data')!.textContent!);
    let timer: ReturnType<typeof setTimeout> | undefined;

    const snapshot = () => {
      // 无原型字典：tier id 允许 '__proto__' 这类特殊字符串
      const rows: Record<string, string[]> = Object.create(null);
      board.querySelectorAll<HTMLElement>('.tier-body').forEach((body) => {
        const id = body.dataset.tier ?? '';
        if (!id) return;
        rows[id] = [...body.querySelectorAll<HTMLElement>('.tcard')].map((c) => c.dataset.run!);
      });
      return { theme: board.dataset.theme, tiers: TIERS, rows };
    };

    const save = () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        saveState.textContent = '保存中…';
        try {
          const res = await fetch(board.dataset.api!, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(snapshot()),
          });
          saveState.textContent = res.ok ? '已保存' : '保存失败（dev 服务没在运行？）';
        } catch {
          saveState.textContent = '保存失败（dev 服务没在运行？）';
        }
      }, 350);
    };

    board.querySelectorAll<HTMLElement>('.tier-body').forEach((body) => {
      new Sortable(body, {
        group: 'tiers',
        animation: 160,
        draggable: '.tcard',
        filter: '.tcard-zoom',
        preventOnFilter: false,
        ghostClass: 'tcard-ghost',
        chosenClass: 'tcard-chosen',
        dragClass: 'tcard-drag',
        delayOnTouchOnly: false,
        touchStartThreshold: 6,
        onSort: save,
      });
    });

    // 双击卡片进详情；Esc 关灯箱
    board.addEventListener('dblclick', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.tcard');
      if (card?.dataset.href) location.href = card.dataset.href;
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && location.hash.startsWith('#z-')) location.hash = '_';
    });
  </script>
</Base>
