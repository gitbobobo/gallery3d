---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import TierMark from '../../components/TierMark.astro';
import RunCard from '../../components/RunCard.astro';
import { AGENTS_MD } from '../../constraints';
import { renderMd } from '../../md';
import {
  baseUrl,
  facetValues,
  loadThemes,
  themeSummary,
  tierGroups,
  type Theme,
  type TierGroup,
} from '../../data';
import { fmtBytes, fmtCost, fmtCount, fmtDuration, sha8 } from '../../format';

export const getStaticPaths = () =>
  loadThemes().map((theme) => ({ params: { themeId: theme.id }, props: { theme } }));

interface Props { theme: Theme }
const { theme } = Astro.props;
const { runs } = theme;

const summary = themeSummary(theme);
const facets = {
  harness: facetValues(runs, 'harness'),
  model: facetValues(runs, 'modelKey'),
  effort: facetValues(runs, 'effort'),
};
const catLabel = (c: string) => (c === '3d' ? '3D' : c === 'web' ? '网页' : c);
const second = runs.find((r) => r.place === 2);

// 尺寸规则：已评级非空组第 1 组 lead、第 2 组 l、其后 s；
// 未评级组在有已评级组时 s、否则 l（没人评过时整页中等卡，无 feature）。
const groups = tierGroups(theme).filter((g) => g.runs.length > 0);
const hasRated = groups.some((g) => g.tier);
let ratedIdx = 0;
const groupSize = (g: TierGroup): 'lead' | 'l' | 's' => {
  if (!g.tier) return hasRated ? 's' : 'l';
  const i = ratedIdx++;
  return i === 0 ? 'lead' : i === 1 ? 'l' : 's';
};

const maxMs = Math.max(0, ...runs.map((r) => r.stats.durationMs ?? 0));
const maxIn = Math.max(0, ...runs.map((r) => r.stats.tokensIn ?? 0));
const pct = (v: number | undefined, max: number) =>
  v === undefined || max <= 0 ? undefined : Math.max(2, Math.round((v / max) * 100));
const tierOf = (id?: string) => theme.ratings.tiers.find((t) => t.id === id) ?? null;

const statsParts = [
  `${summary.total} 份答卷`,
  summary.noDist > 0 ? `${summary.noDist} 份没交` : '',
  `${summary.harnesses} 个 agent`,
  `${summary.models} 个模型`,
  summary.minMs !== undefined
    ? `用时 ${fmtDuration(summary.minMs)} 至 ${fmtDuration(summary.maxMs)}`
    : '',
].filter(Boolean);
---

<Base title={theme.meta.title}>
  <TopBar>
    {import.meta.env.DEV && <a class="btn" href={baseUrl(`${theme.id}/rank/`)}>调整评级</a>}
    <a class="btn" href={baseUrl(`${theme.id}/compare/`)}>对比两份答卷</a>
  </TopBar>

  <div class="tp" id="gallery" data-cover="desktop">
    <div class="tp-side">
      <span class="cat-tag">{catLabel(theme.meta.category)}</span>
    </div>
    <div class="tp-main">
      <div class="tp-head">
        <h1 class="tp-title">{theme.meta.title}</h1>
        <div class="prompt-sheet">
          <span class="kicker">
            题目{theme.meta.promptSha256 && <> · 编号 <span class="mono">{sha8(theme.meta.promptSha256)}</span></>}
          </span>
          <p class:list={['prompt-text', { 'prompt-text--long': theme.prompt.length > 300 }]}>{theme.prompt || '（这道题没有 prompt.md）'}</p>
          <details>
            <summary>每份答卷都拿到同一份约束（AGENTS.md）</summary>
            <div class="notes" set:html={renderMd(AGENTS_MD)} />
          </details>
        </div>
        <p class="tp-stats">
          {statsParts.join(' · ')}{runs.length > 0 && <> · <a href="#data">数据对照 ↓</a></>}
        </p>
      </div>

    </div>

    {runs.length > 0 && (
      <div class="trow trow--filters">
        <div class="trow-side"></div>
        <div class="trow-main">
          <div class="filters">
            <label class="filter">
              <span class="filter-label">Agent</span>
              <select class="sel" id="f-harness">
                <option value="">全部</option>
                {facets.harness.map((f) => (
                  <option value={f.value}>{f.label}（{f.count}）</option>
                ))}
              </select>
            </label>
            <label class="filter">
              <span class="filter-label">模型</span>
              <select class="sel" id="f-model">
                <option value="">全部</option>
                {facets.model.map((f) => (
                  <option value={f.value}>{f.label}（{f.count}）</option>
                ))}
              </select>
            </label>
            {facets.effort.length >= 2 && (
              <label class="filter">
                <span class="filter-label">强度</span>
                <select class="sel" id="f-effort">
                  <option value="">全部</option>
                  {facets.effort.map((f) => (
                    <option value={f.value}>{f.label}（{f.count}）</option>
                  ))}
                </select>
              </label>
            )}
            <span class="count" id="count" aria-live="polite">显示 {runs.length} / {runs.length}</span>
            <span class="cover-wrap">
              <span class="cover-label">封面</span>
              <div class="seg" role="group" aria-label="封面比例" id="cover-seg">
                <button type="button" aria-pressed="true" data-cover="desktop">桌面</button>
                <button type="button" aria-pressed="false" data-cover="mobile">手机</button>
              </div>
            </span>
          </div>
        </div>
      </div>
    )}

    {groups.map((g) => {
      const size = groupSize(g);
      return (
        <div class="trow" data-group>
          <div class="trow-side">
            <TierMark tier={g.tier} count={g.runs.length} />
          </div>
          <section class="tier-sec trow-main" data-size={size}>
            <div class="cards">
              {g.runs.map((r, i) =>
                size === 'lead' && i === 0 ? (
                  <RunCard run={r} theme={theme} feature compareId={second?.id} />
                ) : (
                  <RunCard run={r} theme={theme} />
                ),
              )}
            </div>
          </section>
        </div>
      );
    })}

    <div class="trow" id="no-match" hidden>
      <div class="trow-side"></div>
      <div class="trow-main no-match">
        <span>没有符合条件的答卷。</span>
        <button class="btn" type="button" id="clear-filters">清除筛选</button>
      </div>
    </div>

    {runs.length > 0 && (
      <div class="trow">
        <div class="trow-side"></div>
        <section class="trow-main data-sec" id="data">
          <h2>数据对照</h2>
        <p class="data-note">条形长度按本题最大值换算。成本只有部分 agent 会报告。</p>
        <div class="dtable-wrap">
          <table class="dtable">
            <thead>
              <tr>
                <th>名次</th>
                <th>等级</th>
                <th>模型</th>
                <th>Agent</th>
                <th>强度</th>
                <th class="num">用时</th>
                <th class="num">输入 token</th>
                <th class="num">输出 token</th>
                <th class="num">成本</th>
                <th class="num">产物大小</th>
                <th class="num">控制台报错</th>
              </tr>
            </thead>
            <tbody>
              {runs.map((r) => (
                <tr>
                  <td class="num">{r.place !== undefined ? `#${r.place}` : '—'}</td>
                  <td><TierMark tier={tierOf(r.tierId)} size="sm" /></td>
                  <td><a href={baseUrl(`${theme.id}/view/${r.id}/`)}>{r.modelName}</a></td>
                  <td>{r.harnessName}</td>
                  <td class="num">{r.effort}</td>
                  <td class="num">
                    {fmtDuration(r.stats.durationMs)}
                    {pct(r.stats.durationMs, maxMs) !== undefined && (
                      <span class="bar" style={`--w:${pct(r.stats.durationMs, maxMs)}%`} />
                    )}
                  </td>
                  <td class="num">
                    {fmtCount(r.stats.tokensIn)}
                    {pct(r.stats.tokensIn, maxIn) !== undefined && (
                      <span class="bar" style={`--w:${pct(r.stats.tokensIn, maxIn)}%`} />
                    )}
                  </td>
                  <td class="num">{fmtCount(r.stats.tokensOut)}</td>
                  <td class="num">{fmtCost(r.stats.costUsd)}</td>
                  <td class="num">{fmtBytes(r.stats.distBytes)}</td>
                  <td class="num">
                    {r.stats.consoleErrors === undefined ? '—' : r.stats.consoleErrors}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </section>
      </div>
    )}

    {runs.length === 0 && (
      <div class="trow">
        <div class="trow-side"></div>
        <div class="trow-main">
          <p class="empty">
            这道题还没有答卷。运行 <code>pnpm g run {theme.id}</code> 跑第一份。
          </p>
        </div>
      </div>
    )}
  </div>

  {runs.length > 0 && (
    <script>
      // ---- 筛选：三个原生 select，隐藏不匹配的卡；空组整组隐藏 ----
      const gallery = document.getElementById('gallery')!;
      const cards = [...gallery.querySelectorAll<HTMLElement>('.card')];
      const groups = [...gallery.querySelectorAll<HTMLElement>('.trow[data-group]')];
      const countEl = document.getElementById('count')!;
      const noMatch = document.getElementById('no-match')!;
      const sels = {
        harness: document.getElementById('f-harness') as HTMLSelectElement,
        model: document.getElementById('f-model') as HTMLSelectElement,
        effort: document.getElementById('f-effort') as HTMLSelectElement | null,
      };

      function apply() {
        let shown = 0;
        for (const c of cards) {
          const ok =
            (!sels.harness.value || c.dataset.harness === sels.harness.value) &&
            (!sels.model.value || c.dataset.model === sels.model.value) &&
            (!sels.effort?.value || c.dataset.effort === sels.effort.value);
          c.hidden = !ok;
          if (ok) shown++;
        }
        for (const g of groups) {
          // 组头计数跟随可见卡数；无可见卡的组整组隐藏
          const visible = g.querySelectorAll('.card:not([hidden])').length;
          g.hidden = !visible;
          const tmCount = g.querySelector('.tm-count');
          if (tmCount) tmCount.textContent = `${visible} 份`;
        }
        countEl.textContent = `显示 ${shown} / ${cards.length}`;
        noMatch.hidden = shown > 0;
      }

      for (const s of Object.values(sels)) s?.addEventListener('change', apply);
      document.getElementById('clear-filters')?.addEventListener('click', () => {
        for (const s of Object.values(sels)) if (s) s.value = '';
        apply();
      });

      // ---- 桌面|手机封面切换：gallery[data-cover] + img[data-desktop] src 互换 ----
      const seg = document.getElementById('cover-seg')!;
      seg.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cover]');
        if (!btn) return;
        seg.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        const mode = btn.dataset.cover === 'mobile' ? 'mobile' : 'desktop';
        gallery.dataset.cover = mode;
        gallery.querySelectorAll<HTMLImageElement>('img[data-desktop]').forEach((img) => {
          img.src = (mode === 'mobile' ? img.dataset.mobile : img.dataset.desktop) ?? img.dataset.desktop!;
        });
      });
    </script>
  )}
</Base>
