---
import { BASE } from '../data';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '答卷画廊',
  description = '同一道题目，不同 AI 组合的答卷 —— Gallery3D 评测画廊',
} = Astro.props;

const fullTitle = title === '答卷画廊' ? title : `${title} · 答卷画廊`;

// @font-face is emitted inline so font URLs always respect BASE_URL
// (plain CSS url('/fonts/…') would break on sub-path deployments).
const fontFaceCss = `
@font-face{font-family:'Smiley Sans';src:url('${BASE}fonts/SmileySans-Oblique.ttf.woff2') format('woff2');font-display:swap}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:400;src:url('${BASE}fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2');font-display:swap}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:600;src:url('${BASE}fonts/ibm-plex-mono-latin-600-normal.woff2') format('woff2');font-display:swap}
`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="preload" href={`${BASE}fonts/SmileySans-Oblique.ttf.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${BASE}fonts/ibm-plex-mono-latin-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaceCss}></style>
    <title>{fullTitle}</title>
  </head>
  <body>
    <!-- shared defs for the OMR pencil-scribble bubble fill -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="scribble" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.12" numOctaves="3" seed="7" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="8" />
        </filter>
      </defs>
    </svg>
    <slot />
  </body>
</html>
